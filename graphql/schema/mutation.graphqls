type Mutation {
  torrent: TorrentMutation!
  queue: QueueMutation!
}

type TorrentMutation {
  delete(infoHashes: [Hash20!]!): Void
  putTags(infoHashes: [Hash20!]!, tagNames: [String!]!): Void
  setTags(infoHashes: [Hash20!]!, tagNames: [String!]!): Void
  deleteTags(infoHashes: [Hash20!], tagNames: [String!]): Void
  reprocess(input: TorrentReprocessInput!): Void
  """
  refreshPeers runs a live DHT lookup (BEP 33 scrape) for each torrent and saves the new
  seeder/leecher estimates, including to the counts used by search, sorting and filters
  """
  refreshPeers(infoHashes: [Hash20!]!): [TorrentPeersRefreshResult!]!
}

type TorrentPeersRefreshResult {
  infoHash: Hash20!
  ok: Boolean!
  error: String
  nodesQueried: Int!
  nodesResponded: Int!
  """
  nodesWithPeers counts responding nodes that were tracking peers for the torrent
  """
  nodesWithPeers: Int!
  seedersBefore: Int
  leechersBefore: Int
  seeders: Int
  leechers: Int
}

input TorrentReprocessInput {
  infoHashes: [Hash20!]!
  classifierRematch: Boolean
  classifierWorkflow: String
  apisDisabled: Boolean
  localSearchDisabled: Boolean
}
